{
  "sourceLanguage" : "en",
  "strings" : {
    "intents.remote.device" : {
      "comment" : "Shortcuts parameter: which of the user's other devices to control. Optional; without it the device that played last.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Device"
          }
        }
      }
    },
    "intents.remote.device.type" : {
      "comment" : "Shortcuts: the name of the type of thing the remote-control actions act on, another device playing from Jellyfin.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Device"
          }
        }
      }
    },
    "intents.remote.error.nothingPlaying" : {
      "comment" : "Shortcuts/Siri: a remote-control action found no other device playing anything.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing is playing on your other devices."
          }
        }
      }
    },
    "intents.remote.error.notPlaying %@" : {
      "comment" : "Shortcuts/Siri: the chosen device is not playing. %@ is the device name, e.g. Living Room.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ isn't playing anything right now."
          }
        }
      }
    },
    "intents.remote.error.signedOut" : {
      "comment" : "Shortcuts/Siri: a remote-control action ran while no Jellyfin account is signed in.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign in to Sodalite first."
          }
        }
      }
    },
