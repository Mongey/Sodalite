    "intents.playOn.error.deviceUnavailable" : {
      "comment" : "Siri/Shortcuts/widget: the chosen device is not connected to the server, so it cannot be told to play.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That device isn't available. Open a Jellyfin app on it and try again."
          }
        }
      }
    },
    "intents.playOn.error.nothingUpNext" : {
      "comment" : "Siri/Shortcuts: Play Next on Device ran but nothing is in Continue Watching or Next Up.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing is up next. You're all caught up."
          }
        }
      }
    },
    "intents.playOn.item.item" : {
