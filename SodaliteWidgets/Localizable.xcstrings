{
  "sourceLanguage" : "en",
  "strings" : {
    "control.remote.description" : {
      "comment" : "Control Center gallery: description of the remote play/pause control.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pause or resume whatever your other device is playing."
          }
        }
      }
    },
    "control.remote.name" : {
      "comment" : "Control Center gallery: name of the control that plays or pauses the user's other device.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Other Device"
          }
        }
      }
    },
