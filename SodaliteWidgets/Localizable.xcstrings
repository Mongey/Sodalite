        }
      }
    },
    "intents.playOn.upNext.done %@ %@" : {
      "comment" : "Siri/Shortcuts confirmation. The first %@ is what plays (e.g. Severance \u00b7 S1, E3 \u00b7 Half Loop), the second the device name (e.g. Living Room).",
