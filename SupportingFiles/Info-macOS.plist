<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Kept alone for the same reason as in Info.plist: any sibling exception key disables it. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Sodalite reaches Jellyfin and AetherEngine media servers on your local network. Required for direct play of media from a server in your home.</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>de.superuser404.Sodalite</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>sodalite</string>
			</array>
		</dict>
	</array>
	<!-- macOS loads bundled fonts from a folder relative to Contents/Resources, not from UIAppFonts. -->
	<key>ATSApplicationFontsPath</key>
	<string>.</string>
</dict>
</plist>
